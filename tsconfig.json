{
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "esnext",
        "strict": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "strictBuiltinIteratorReturn": true,
        "strictPropertyInitialization": true,
        "noEmit": true,
        "types": ["node"],
        "lib": ["ESNext"]
    },
    "exclude": ["node_modules", "**/node_modules/*"],
    "include": ["src", "bin"]
}
