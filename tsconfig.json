{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "sourceMap": true,
        "typeRoots": ["./types/@types", "./node_modules/@types"]
    },
    "exclude": ["node_modules", "**/node_modules/*"]
}
