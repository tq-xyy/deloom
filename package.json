{
    "name": "deloom",
    "version": "1.1.0",
    "description": "A tool to uncompress and unbundle JavaScript bundles created by webpack, terser, and others.",
    "main": "dist/index.js",
    "types": "types/index.d.ts",
    "bin": {
        "deloom": "dist/cli.js"
    },
    "files": [
        "dist/",
        "README.md",
        "README_zh.md",
        "LICENSE"
    ],
    "license": "MIT",
    "author": {
        "name": "tq-xyy",
        "url": "https://github.com/tq-xyy"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tq-xyy/deloom.git"
    },
    "engines": {
        "node": ">=16"
    },
    "scripts": {
        "lint": "prettier -w src/**/*.ts **/*.json",
        "build": "npm run clean && esbuild src/**/*.ts --platform=node --format=cjs --outdir=dist --tsconfig=tsconfig.json --sourcemap",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build && npm run lint"
    },
    "dependencies": {
        "@babel/generator": "^8.0.0",
        "@babel/parser": "^8.0.4",
        "@babel/template": "^8.0.0",
        "@babel/traverse": "^8.0.4",
        "@babel/types": "^8.0.4",
        "commander": "^15.0.0",
        "prettier": "^3.9.6"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "esbuild": "^0.28.2",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    }
}
