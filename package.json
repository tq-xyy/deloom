{
    "name": "deloom",
    "description": "A tool to uncompress and unbundle JavaScript bundles created by webpack, terser, and others.",
    "version": "0.1",
    "license": "MIT",
    "author": {
        "name": "tq-xyy",
        "url": "https://github.com/tq-xyy"
    },
    "scripts": {
        "lint": "prettier -w *.ts *.json",
        "test:uncompress": "esno ./bin/cli.ts uncompress ./test/test-uncompress.js ./test/test-uncompress.out.js --throw-errors",
        "test:unbundle": "esno ./bin/cli.ts unbundle ./test/test-unbundle ./test/test-unbundle.out"
    },
    "dependencies": {
        "@babel/generator": "^7.29.7",
        "@babel/parser": "^7.29.7",
        "@babel/template": "^7.29.7",
        "@babel/traverse": "^7.29.7",
        "@babel/types": "^7.29.7",
        "commander": "^15.0.0",
        "prettier": "^3.8.3"
    },
    "devDependencies": {
        "@types/babel__generator": "^7.27.0",
        "@types/babel__traverse": "^7.28.0",
        "@types/node": "^25.9.2",
        "esbuild": "^0.28.0",
        "esno": "^4.8.0"
    }
}
